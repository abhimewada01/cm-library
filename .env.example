API_PORT=4000
JWT_SECRET=replace-with-at-least-32-random-characters
DB_PATH=server/data/library.sqlite
# Use your computer's Wi-Fi IPv4 address so Expo Go on your phone can connect.
EXPO_PUBLIC_API_BASE_URL=http://192.168.1.12:4000/v1
# Supabase Expo client values are public and safe to bundle; never put a service-role key here.
EXPO_PUBLIC_SUPABASE_URL=https://gormwrvxstkgavupangf.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-your-project-publishable-key

# Server-only values. Store real credentials in local .env / deployment secrets only.
SUPABASE_URL=https://gormwrvxstkgavupangf.supabase.co
SUPABASE_SERVICE_ROLE_KEY=server-only-secret-do-not-use-in-expo
SUPABASE_DB_URL=postgresql://postgres:replace-me@db.gormwrvxstkgavupangf.supabase.co:5432/postgres
BACKUP_OFFSITE_SUPABASE_URL=https://your-separate-backup-project.supabase.co
BACKUP_OFFSITE_SERVICE_ROLE_KEY=server-only-offsite-secret
BACKUP_ENCRYPTION_KEY_BASE64=generate-a-random-32-byte-key
SUPABASE_STAGING_DB_URL=postgresql://postgres:replace-me@your-staging-db-host:5432/postgres
